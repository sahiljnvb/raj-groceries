---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="hi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>बिल बनाएं – Raj Groceries</title>
    <meta name="theme-color" content="#15803d" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hind:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="bar noprint">
      <a href={`${base}/`}>← वेबसाइट</a>
      <strong>🧾 बिल बनाएं</strong>
    </header>

    <main class="sheet">
      <div class="head">
        <h1>Raj Groceries</h1>
        <p>घुघरी, जिला मंडला (म.प्र.) • +91 72249 62386</p>
        <p class="meta">बिल नं: <span id="billno">1</span> &nbsp;•&nbsp; तारीख: <span id="date"></span></p>
      </div>

      <div class="cust noprint-border">
        <label>ग्राहक का नाम <input id="cname" placeholder="नाम" /></label>
        <label>मोबाइल नंबर <input id="cphone" inputmode="numeric" maxlength="10" placeholder="10 अंक (WhatsApp के लिए)" /></label>
      </div>

      <table>
        <thead>
          <tr><th>#</th><th>सामान</th><th>मात्रा</th><th>रेट ₹</th><th>रकम ₹</th><th class="noprint"></th></tr>
        </thead>
        <tbody id="rows"></tbody>
      </table>

      <button id="add" class="btn ghost noprint" type="button">➕ सामान जोड़ें</button>

      <div class="totals">
        <div><span>कुल (Subtotal)</span><b id="sub">₹0.00</b></div>
        <div class="disc noprint-flex"><span>छूट ₹</span><input id="disc" type="number" min="0" step="any" value="0" /></div>
        <div class="disc-print" id="discline"><span>छूट</span><b id="discv">₹0.00</b></div>
        <div class="grand"><span>कुल देय</span><b id="total">₹0.00</b></div>
      </div>

      <p class="thanks">धन्यवाद! फिर पधारिए 🙏</p>
    </main>

    <div class="actions noprint">
      <button id="wa" class="btn wa" type="button">💬 WhatsApp पर भेजें</button>
      <button id="print" class="btn" type="button">🖨️ प्रिंट / PDF</button>
      <button id="new" class="btn ghost" type="button">🆕 नया बिल</button>
    </div>

    <script is:inline>
      var KEY = 'raj-bill-no';
      var rowsEl = document.getElementById('rows');
      var money = function (n) { return '₹' + (Math.round(n * 100) / 100).toFixed(2); };
      var num = function (v) { var n = parseFloat(v); return isNaN(n) ? 0 : n; };

      function billNo(inc) {
        var n = 1;
        try { n = parseInt(localStorage.getItem(KEY) || '1', 10) || 1; if (inc) { n++; localStorage.setItem(KEY, String(n)); } } catch (e) {}
        return n;
      }

      function addRow() {
        var tr = document.createElement('tr');
        tr.innerHTML =
          '<td class="idx"></td>' +
          '<td class="c-it"><input class="it" placeholder="सामान का नाम" /></td>' +
          '<td class="c-qt" data-l="मात्रा"><input class="qt" type="number" min="0" step="any" value="1" /></td>' +
          '<td class="c-rt" data-l="रेट ₹"><input class="rt" type="number" min="0" step="any" placeholder="0" /></td>' +
          '<td class="amt" data-l="रकम">₹0.00</td>' +
          '<td class="noprint"><button class="x" type="button" aria-label="हटाएं">✕</button></td>';
        rowsEl.appendChild(tr);
        recalc();
        return tr;
      }

      function recalc() {
        var sub = 0;
        Array.prototype.forEach.call(rowsEl.children, function (tr, i) {
          tr.querySelector('.idx').textContent = i + 1;
          var a = num(tr.querySelector('.qt').value) * num(tr.querySelector('.rt').value);
          tr.querySelector('.amt').textContent = money(a);
          sub += a;
        });
        var d = Math.min(num(document.getElementById('disc').value), sub);
        document.getElementById('sub').textContent = money(sub);
        document.getElementById('discv').textContent = '- ' + money(d);
        document.getElementById('discline').style.display = d > 0 ? '' : 'none';
        document.getElementById('total').textContent = money(sub - d);
        return { sub: sub, d: d, total: sub - d };
      }

      function reset() {
        rowsEl.innerHTML = '';
        document.getElementById('cname').value = '';
        document.getElementById('cphone').value = '';
        document.getElementById('disc').value = 0;
        document.getElementById('billno').textContent = billNo(false);
        document.getElementById('date').textContent = new Date().toLocaleDateString('en-IN');
        addRow();
      }

      rowsEl.addEventListener('input', recalc);
      rowsEl.addEventListener('click', function (e) {
        if (e.target.classList.contains('x')) {
          e.target.closest('tr').remove();
          if (!rowsEl.children.length) addRow(); else recalc();
        }
      });
      document.getElementById('disc').addEventListener('input', recalc);
      document.getElementById('add').addEventListener('click', function () { addRow().querySelector('.it').focus(); });
      document.getElementById('print').addEventListener('click', function () { window.print(); });
      document.getElementById('new').addEventListener('click', function () {
        if (confirm('नया बिल शुरू करें? मौजूदा बिल हट जाएगा।')) { billNo(true); reset(); }
      });

      document.getElementById('wa').addEventListener('click', function () {
        var t = recalc();
        var lines = ['*Raj Groceries* – घुघरी, मंडला', 'बिल नं: ' + document.getElementById('billno').textContent + ' | तारीख: ' + document.getElementById('date').textContent];
        var cn = document.getElementById('cname').value.trim();
        if (cn) lines.push('ग्राहक: ' + cn);
        lines.push('------------------');
        var n = 0;
        Array.prototype.forEach.call(rowsEl.children, function (tr) {
          var name = tr.querySelector('.it').value.trim();
          var q = num(tr.querySelector('.qt').value), r = num(tr.querySelector('.rt').value);
          if (!name && !r) return;
          n++;
          lines.push(n + '. ' + (name || 'सामान') + ' – ' + q + ' × ' + r + ' = ' + money(q * r));
        });
        lines.push('------------------');
        if (t.d > 0) { lines.push('कुल: ' + money(t.sub)); lines.push('छूट: -' + money(t.d)); }
        lines.push('*कुल देय: ' + money(t.total) + '*');
        lines.push('धन्यवाद! फिर पधारिए 🙏');
        var ph = document.getElementById('cphone').value.replace(/\D/g, '');
        var to = ph.length === 10 ? '91' + ph : '';
        window.open('https://wa.me/' + to + '?text=' + encodeURIComponent(lines.join('\n')), '_blank');
      });

      reset();
    </script>
  </body>
</html>

<style is:global>
  :root { --g: #15803d; --gd: #14532d; --ink: #1c2b22; }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: 'Hind', system-ui, sans-serif; background: #f3f7f1; color: var(--ink); font-size: 16px; padding-bottom: 140px; }
  .bar { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; background: var(--gd); color: #fff; }
  .bar a { color: #fff; text-decoration: none; }
  .sheet { max-width: 760px; margin: 16px auto; background: #fff; padding: 20px 16px; border-radius: 14px; box-shadow: 0 2px 12px rgba(0,0,0,.08); }
  .head { text-align: center; border-bottom: 2px dashed #b7d4bd; padding-bottom: 12px; margin-bottom: 14px; }
  .head h1 { margin: 0; color: var(--gd); }
  .head p { margin: 2px 0; }
  .meta { font-size: .95rem; color: #4b5d52; }
  .cust { display: grid; gap: 10px; margin-bottom: 14px; }
  @media (min-width: 600px) { .cust { grid-template-columns: 1fr 1fr; } }
  label { display: grid; gap: 4px; font-weight: 600; font-size: .9rem; }
  input { font: inherit; padding: 8px 10px; border: 1px solid #b7d4bd; border-radius: 8px; width: 100%; background: #fff; }
  input:focus { outline: 3px solid #dcfce7; border-color: var(--g); }
  table { width: 100%; border-collapse: collapse; margin-bottom: 12px; }
  th, td { padding: 4px; text-align: left; vertical-align: middle; }
  th { font-size: .85rem; color: #4b5d52; border-bottom: 2px solid #dfeee2; }
  td.idx { width: 24px; color: #6b7d72; }
  td.amt { text-align: right; font-weight: 600; white-space: nowrap; }
  th:nth-child(5) { text-align: right; }
  .qt { width: 70px; } .rt { width: 84px; }
  .x { background: #fee2e2; color: #b91c1c; border: 0; border-radius: 8px; width: 30px; height: 30px; cursor: pointer; }
  .btn { font: inherit; font-weight: 600; padding: 11px 16px; border-radius: 12px; border: 2px solid var(--g); background: var(--g); color: #fff; cursor: pointer; }
  .btn.ghost { background: #fff; color: var(--gd); }
  .btn.wa { background: #25d366; border-color: #25d366; }
  .totals { margin-top: 16px; display: grid; gap: 6px; max-width: 320px; margin-left: auto; }
  .totals > div { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .disc input { width: 110px; text-align: right; }
  .disc-print { display: none; }
  .grand { font-size: 1.3rem; border-top: 2px solid var(--ink); padding-top: 8px; color: var(--gd); }
  .thanks { text-align: center; margin: 20px 0 0; color: #4b5d52; }
  .actions { position: fixed; left: 0; right: 0; bottom: 0; display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; padding: 10px; background: rgba(255,255,255,.96); box-shadow: 0 -4px 16px rgba(0,0,0,.12); }
  @media (max-width: 599px) {
    thead { display: none; }
    table, tbody { display: block; }
    tbody tr { display: grid; grid-template-columns: 1fr 1fr 1fr 34px; gap: 6px; align-items: end; padding: 10px 0; border-bottom: 1px solid #dfeee2; }
    td.idx { display: none; }
    td.c-it { grid-column: 1 / -1; }
    td[data-l]::before { content: attr(data-l); display: block; font-size: .75rem; color: #6b7d72; }
    .qt, .rt { width: 100%; }
    td.amt { text-align: left; }
  }
  @media print {
    .noprint, .actions { display: none !important; }
    body { background: #fff; padding: 0; }
    .sheet { box-shadow: none; margin: 0; max-width: none; }
    input { border: 0; padding: 0; background: transparent; appearance: none; }
    .qt, .rt { width: auto; }
    .noprint-flex { display: none !important; }
  }
</style>
